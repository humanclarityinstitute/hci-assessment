        "very high thinking partnership",
        "high agency",
        "low delegation",
        "frequent overriding",
        "moderate emotional use"
      ],
      "expected_profile": "RP01_ACTIVE_THINKING_PARTNER",
      "acceptable_highlights": [
        "HL-TP01",
        "HL-AG02",
        "HL-AG03"
      ],
      "must_not_trigger": [
        "RP08_AI_CARRYING_MORE_AUTHORITY"
      ],
      "rationale": "Thinking partnership is dominant and corroborated by retained authority."
    },
    {
